      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\n\nskinparam classAttributeIconSize 0\n\n&#39; 1. The Client\nclass \&quot;Client Application\&quot; as Client {\n}\n\n&#39; 2. The Facade Class (Center)\nclass CityServiceFacade {\n    - complaint: ComplaintRegistrationSystem\n    - router: DepartmentRoutingSystem\n    - sms: SMSNotificationSystem\n    - tracker: TrackingSystem\n    - billing: BillingSystem\n    --\n    + requestService(serviceType: String): void\n    + trackRequest(requestId: String): void\n}\n\n&#39; 3. The Subsystem Classes\nclass ComplaintRegistrationSystem {\n    + registerComplaint(serviceType: String): String\n}\n\nclass DepartmentRoutingSystem {\n    + routeToDepartment(serviceType: String): void\n}\n\nclass SMSNotificationSystem {\n    + sendSMS(message: String): void\n}\n\nclass TrackingSystem {\n    + track(requestId: String): void\n}\n\nclass BillingSystem {\n    + generateBill(serviceType: String): void\n}\n\n&#39; 4. Relationships\n&#39; Client uses Facade\nClient -&gt; CityServiceFacade\n\n&#39; Facade uses Subsystems (Unidirectional associations)\nCityServiceFacade --&gt; ComplaintRegistrationSystem\nCityServiceFacade --&gt; DepartmentRoutingSystem\nCityServiceFacade --&gt; SMSNotificationSystem\nCityServiceFacade --&gt; TrackingSystem\nCityServiceFacade --&gt; BillingSystem\n\n@enduml&quot;,&#xa;  &quot;format&quot;: &quot;svg&quot;&#xa;}" id="sIR8fLyyOKJ3eKx_p0wC-1">
          <mxCell parent="1" style="shape=image;noLabel=1;verticalAlign=top;aspect=fixed;imageAspect=0;image=data:image/svg+xml,;" vertex="1">
